manifest {
    name            = 'repository-pipeline'
    author          = 'team'
    version         = '0.1.0'
    nextflowVersion = '!>=24.04.0'
}

params {
    input_stage01 = 'input/stage01_scrap/*.csv'
    input_stage02  = 'input/stage02_batch/*.csv'
    input_stage03  = 'input/stage03_dataset/*.csv'
    input_dump    = 'input/stage99_dumpdb/*.request'

    silver_dir = 'output/silver'
    bronze_dir = 'output/bronze'
    dump_dir   = 'output/dump'
}

process {
    executor = 'local'
    shell    = ['/bin/bash', '-euo', 'pipefail']

    withName: REPOSITORY_TO_PARQUET {
        publishDir [path: "${params.silver_dir}/repositories", mode: 'copy']
    }

    withName: REPOSITORY_FILES_EXTRACT {
        publishDir "${params.silver_dir}/files", mode: 'copy'
        maxForks = 1
    }

    withName: REPOSITORY_SUMMARY {
        publishDir "${params.dump_dir}/01repo", mode: 'copy'
    }

    withName: BATCH_SPLIT_STRATIFIED {
        publishDir "${params.dump_dir}/03split", mode: 'copy'
    }

    withName: DATASET_MANIFEST_TO_PARQUET {
        publishDir "${params.silver_dir}/datasets", mode: 'copy'
    }

    withName: DOWNLOAD_TRANSCODE_PUBLISH {
        publishDir "${params.bronze_dir}", mode: 'copy'
        maxForks = 1
    }

    withName: INGEST_BRONZE_METADATA {
        publishDir "${params.silver_dir}/bronze_metadata", mode: 'copy'
        cpus = 1
        memory = '16 GB'
    }

    withName: PARQUET_TO_SQL_DUMP {
        publishDir "${params.dump_dir}/99sql", mode: 'copy'
    }
}
