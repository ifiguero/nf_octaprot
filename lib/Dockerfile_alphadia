# -------------------------------------------------------------------
# Stage 1: Clone the repository
# -------------------------------------------------------------------
FROM alpine/git:latest AS repo

WORKDIR /src

RUN git clone --depth 1 https://github.com/MannLabs/alphadia .


# -------------------------------------------------------------------
# Stage 2: Build compatible /usr/bin/time
# -------------------------------------------------------------------
FROM debian:bullseye AS tool-provider

RUN apt-get update && \
    apt-get install -y --no-install-recommends time && \
    rm -rf /var/lib/apt/lists/*


# -------------------------------------------------------------------
# Stage 3: Application image
# -------------------------------------------------------------------
FROM mosthege/pythonnet:python3.11.2-mono6.12-pythonnet3.0.1

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

#ARG UID=10001

#RUN adduser \
#    --disabled-password \
#    --gecos "" \
#    --home "/home/alphadiauser" \
#    --shell "/sbin/nologin" \
#    --uid "${UID}" \
#    alphadiauser

COPY --from=repo /src/pyproject.toml pyproject.toml
COPY --from=repo /src/docs docs
COPY --from=repo /src/gui gui
COPY --from=repo /src/requirements requirements
COPY --from=repo /src/alphadia alphadia
COPY --from=repo /src/MANIFEST.in MANIFEST.in

RUN pip install --upgrade pip && \
    pip install --pre --no-cache-dir ".[stable]"

# Install AlphaPeptDeep pretrained models at build time
RUN mkdir -p /root/peptdeep/pretrained_models && \
    python -c "import urllib.request; urllib.request.urlretrieve('https://github.com/MannLabs/alphapeptdeep/releases/download/pre-trained-models/pretrained_models_v3.zip', '/tmp/pretrained_models_v3.zip')" && \
    peptdeep install-models --model-file /tmp/pretrained_models_v3.zip && \
    rm /tmp/pretrained_models_v3.zip

COPY --from=tool-provider /usr/bin/time /usr/bin/time

#USER alphadiauser

CMD ["alphadia", "--config", "/app/data/config/config.yaml"]
