manifest {
    name            = 'nf_octaprot'
    author          = 'ilab octo team'
    version         = '0.2.0'
    nextflowVersion = '!>=24.04.0'
}

params {

    // Seach PSM variables
    search_mode = 'deep'
    precursor_tol    = [5, 10, 20, 30]
    fragment_tol     = [5, 10, 20, 30]
    missed_cleavages = [0, 1, 2, 3]
    min_peptide_len  = [7, 8, 9]
    max_peptide_len  = [30, 40, 50]

    // Path visible INSIDE every container

    input_fasta   = "${projectDir}/input/stage00_fasta/*.fasta"
    input_stage01   = "${projectDir}/input/stage01_scrap/*.csv"
    input_stage02   = "${projectDir}/input/stage02_batch/*.csv"
    input_stage03   = "${projectDir}/input/stage03_dataset/*.csv"
    input_dump      = "${projectDir}/input/stage99_dumpdb/*.request"

    gold_dir = "${projectDir}/output/gold"
    silver_dir = "${projectDir}/output/silver"
    bronze_dir = "${projectDir}/output/bronze"
    dump_dir   = "${projectDir}/output/dump"
    maxFTPcon      = 1

}

workDir = "${projectDir}/work"

process {
        executor = 'k8s'
        cpus = 1
        memory = '2 GB'
        container = 'dev.ilab.usm.cl/dia/nf_octaprot_uv_base'
        errorStrategy = 'ignore'
}

k8s {
    namespace = 'nextflow'
    pod = [[
            hostPath: '/home',
            mountPath: '/home'
        ]]
    autoMountHostPaths = false
  }

report {
      enabled = true
      file = 'report.html'
    }

timeline {
      enabled = true
      file = 'timeline.html'
  }
